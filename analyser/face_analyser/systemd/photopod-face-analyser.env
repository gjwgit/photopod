# Secrets for the PhotoPod face analyser.
#
# Install as /etc/photopod-face-analyser.env with mode 600, owned by root.
# Values here override anything in config.yaml.

# The security key the Analyser Pod was initialised with in PhotoPod.
PHOTOPOD_FACE_ANALYSER_SECURITY_KEY=

# Client credentials issued by the Solid server for the Analyser account
# (the same pair HealthPod's analyser uses will do).
PHOTOPOD_FACE_ANALYSER_CLIENT_ID=
PHOTOPOD_FACE_ANALYSER_CLIENT_SECRET=
